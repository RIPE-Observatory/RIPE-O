    "id" : "8"
  }, {
    "iri" : "https://w3id.org/ripe/ripe-o#AutomatedAgent",
    "baseIri" : "https://w3id.org/ripe/ripe-o",
    "instances" : 0,
    "label" : {
      "IRI-based" : "AutomatedAgent",
      "en" : "Automated agent"
    },
    "comment" : {
      "en" : "A ripe:AutomatedAgent is a prov:SoftwareAgent representing a software agent that participates in a ripe:ResearchIntegrityAssessment by gathering evidence, deriving assessment-relevant information, or producing initial outcomes. Software that can perform ripe:EvidenceAggregation and produce ripe:IntegrityAssessmentHypothesis instances without human intervention is modelled as a ripe:AutomatedAgent."
    },
    "id" : "11",
    "superClasses" : [ "12" ]
  }, {
