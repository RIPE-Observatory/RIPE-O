    "id" : "13"
  }, {
    "iri" : "https://w3id.org/ripe/ripe-o#IntegrityAssessmentQuestion",
    "baseIri" : "https://w3id.org/ripe/ripe-o",
    "instances" : 0,
    "label" : {
      "IRI-based" : "IntegrityAssessmentQuestion",
      "en" : "Integrity assessment question"
    },
    "subClasses" : [ "18" ],
    "comment" : {
      "en" : "A ripe:IntegrityAssessmentQuestion is a tido:RQ and prov:Entity representing one specific integrity-related question investigated within a ripe:ResearchIntegrityAssessment. It is answered by one or more ripe:IntegrityAssessmentHypothesis instances via tido:answers. An example of a ripe:IntegrityAssessmentQuestion is a question asking whether a ripe:Work has an associated retraction."
    },
    "id" : "14",
    "superClasses" : [ "13", "17" ]
  }, {
    "iri" : "https://w3id.org/ripe/ripe-o#Work",
    "baseIri" : "https://w3id.org/ripe/ripe-o",
    "instances" : 0,
    "label" : {
      "IRI-based" : "Work",
      "en" : "Work"
    },
    "comment" : {
      "en" : "A ripe:Work is a fabio:Work and prov:Entity representing a work relevant to a ripe:ResearchIntegrityAssessment. It may be the subject of an assessment, a cited publication, or another work connected to assessment evidence, such as an article associated with a publication notice. For example, an article, a cited paper, or an article retracted by a notice may be represented as a ripe:Work."
    },
    "id" : "15",
    "superClasses" : [ "13", "19" ]
  }, {
    "iri" : "https://w3id.org/ripe/ripe-o#ExpressionOfConcern",
    "baseIri" : "https://w3id.org/ripe/ripe-o",
    "instances" : 0,
    "label" : {
      "IRI-based" : "ExpressionOfConcern",
      "en" : "Expression of concern"
    },
    "comment" : {
      "en" : "A ripe:ExpressionOfConcern is a fabio:Comment and ripe:IntegrityAssessmentEvidence representing a formal journal or publisher notice that raises concerns about a work and is used as evidence in a ripe:ResearchIntegrityAssessment. For example, a publisher notice questioning the reliability of a published article is an expression of concern."
    },
    "id" : "21",
    "superClasses" : [ "10", "2" ]
  }, {
