    "id" : "26"
  }, {
    "iri" : "https://w3id.org/ripe/ripe-o#IntegrityAssessmentEvidence",
    "baseIri" : "https://w3id.org/ripe/ripe-o",
    "instances" : 0,
    "label" : {
      "IRI-based" : "IntegrityAssessmentEvidence",
      "en" : "Integrity assessment evidence"
    },
    "subClasses" : [ "23", "29", "6", "21", "9", "1", "36" ],
    "comment" : {
      "en" : "A ripe:IntegrityAssessmentEvidence is a tido:Evidence item used to support, challenge, or contextualise a ripe:ResearchIntegrityAssessment. Publication metadata, registry evidence, study-design evidence, publication notices, and peer comments used in an integrity assessment are examples of ripe:IntegrityAssessmentEvidence."
    },
