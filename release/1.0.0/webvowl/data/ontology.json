    "iri" : "https://w3id.org/ripe/ripe-o#EvidenceAggregation",
    "baseIri" : "https://w3id.org/ripe/ripe-o",
    "instances" : 0,
    "label" : {
      "IRI-based" : "EvidenceAggregation",
      "en" : "Evidence aggregation"
    },
    "comment" : {
      "en" : "A ripe:EvidenceAggregation is a prov:Activity representing the aggregation of evidence and source records used in a ripe:ResearchIntegrityAssessment. It provides provenance for the evidence collected for one ripe:ResearchIntegrityAssessment. Retrieval of registry records and publication notices for a research integrity assessment is one such activity."
    },
    "id" : "7",
    "superClasses" : [ "8" ]
  }, {
    "iri" : "https://w3id.org/ripe/ripe-o#PeerComment",
    "baseIri" : "https://w3id.org/ripe/ripe-o",
    "instances" : 0,
    "label" : {
      "IRI-based" : "PeerComment",
      "en" : "Peer comment"
    },
    "comment" : {
      "en" : "A ripe:PeerComment is a fabio:Comment and ripe:IntegrityAssessmentEvidence representing a post-publication comment from the research community about a work and used as evidence in a ripe:ResearchIntegrityAssessment. For example, a PubPeer comment discussing methodological concerns is a ripe:PeerComment."
    },
    "id" : "9",
    "superClasses" : [ "10", "2" ]
  }, {
