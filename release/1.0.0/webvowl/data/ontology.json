    "instances" : 0,
    "label" : {
      "IRI-based" : "PublicationDetails",
      "en" : "Publication details"
    },
    "comment" : {
      "en" : "A ripe:PublicationDetails is a fabio:BibliographicMetadata and ripe:IntegrityAssessmentEvidence representing bibliographic metadata describing a work. It may record values such as title, publication venue, publisher, identifiers, and publication date. A record containing title, journal, publisher, and publication date for an article is one such instance."
    },
    "id" : "23",
    "superClasses" : [ "55", "2" ]
  }, {
    "iri" : "https://w3id.org/ripe/ripe-o#HumanReviewer",
    "baseIri" : "https://w3id.org/ripe/ripe-o",
    "instances" : 0,
    "label" : {
      "IRI-based" : "HumanReviewer",
      "en" : "Human reviewer"
    },
    "comment" : {
      "en" : "A ripe:HumanReviewer is a prov:Person and foaf:Person representing a human agent who participates in a ripe:ResearchIntegrityAssessment by evaluating evidence and recording ripe:IntegrityAssessmentHypothesis instances. A systematic reviewer investigating research integrity of a study is a ripe:HumanReviewer."
    },
    "id" : "25",
    "superClasses" : [ "26", "46" ]
  }, {
    "iri" : "https://w3id.org/ripe/ripe-o#CorrectionNotice",
    "baseIri" : "https://w3id.org/ripe/ripe-o",
    "instances" : 0,
    "label" : {
      "IRI-based" : "CorrectionNotice",
      "en" : "Correction notice"
    },
    "comment" : {
      "en" : "A ripe:CorrectionNotice is a fabio:Correction and ripe:IntegrityAssessmentEvidence representing a formal correction notice about a work and used as evidence in a ripe:ResearchIntegrityAssessment. For example, an erratum correcting a published article is a ripe:CorrectionNotice."
    },
    "id" : "6",
    "superClasses" : [ "2", "5" ]
  }, {
    "iri" : "https://w3id.org/ripe/ripe-o#Author",
    "baseIri" : "https://w3id.org/ripe/ripe-o",
    "instances" : 0,
    "label" : {
      "IRI-based" : "Author",
      "en" : "Author"
    },
    "comment" : {
      "en" : "A ripe:Author is a prov:Person and foaf:Person representing a person associated with an assessment-relevant resource represented in a ripe:ResearchIntegrityAssessment. Such resources may include works and other pieces of information, such as peer comments. The author of a journal article or the person named as responsible for a peer comment are examples of ripe:Author."
    },
    "id" : "33",
    "superClasses" : [ "26", "46" ]
  }, {
    "iri" : "https://w3id.org/ripe/ripe-o#RegistryEvidence",
    "baseIri" : "https://w3id.org/ripe/ripe-o",
    "instances" : 0,
    "label" : {
      "IRI-based" : "RegistryEvidence",
      "en" : "Registry evidence"
    },
    "comment" : {
      "en" : "A ripe:RegistryEvidence is a ripe:IntegrityAssessmentEvidence representing information recorded in a registry about a registered study or clinical trial. It may record values such as the registry identifier, registration date, registry name, registry link, and the associated registration assessment rationale. A ClinicalTrials.gov or WHO ICTRP entry associated with a clinical trial publication is one such instance."
    },
    "id" : "1",
    "superClasses" : [ "2" ]
  }, {
