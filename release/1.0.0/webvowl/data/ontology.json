    "label" : {
      "IRI-based" : "StudyDesignEvidence",
      "en" : "Study design evidence"
    },
    "comment" : {
      "en" : "A ripe:StudyDesignEvidence is a ripe:IntegrityAssessmentEvidence representing information about the design and timeline of a registered study or clinical trial. It may record values such as recruitment start, recruitment end, and study end dates, together with rationales supporting those assigned values. A record describing the recruitment and completion timeline of a clinical study is one such instance."
    },
    "id" : "36",
    "superClasses" : [ "2" ]
  } ],
